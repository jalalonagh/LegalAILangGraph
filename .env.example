# =============================================================================
# Application Settings
# =============================================================================
APP_ENV=development
APP_DEBUG=false
PROJECT_NAME="Legal AI Assistant"
VERSION=0.1.0
RELOAD=true

# =============================================================================
# API Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
MAX_REQUEST_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# Authentication / Authorization
# =============================================================================
JWT_ALGORITHM=HS256
JWT_AUDIENCE=legal-ai-internal
JWT_ISSUER=legal-ai
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=
# For development only - DO NOT use a static secret in production.
# In production, use JWT_PUBLIC_KEY_PATH / JWT_PRIVATE_KEY_PATH.
JWT_SECRET_KEY=change-me-in-production-use-env-or-key-file
JWT_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Service-to-Service authentication (internal)
# =============================================================================
INTERNAL_API_KEY=change-me-internal-api-key
# Comma-separated list of trusted service URLs.
TRUSTED_SERVICE_URLS=http://localhost:8000

# =============================================================================
# Database (PostgreSQL for LangGraph checkpoint persistence)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://legalai:legalai@postgres:5432/legalai

# =============================================================================
# Redis (caching, rate limiting, streaming state)
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_GRPC_PORT=6334
VECTOR_DB_API_KEY=
VECTOR_DB_ENABLED=true
VECTOR_DB_RERANK_TOP_K=100
EMBEDDING_DIM=1024

# =============================================================================
# LLM Providers
# =============================================================================
# Default provider: ollama or openai or openai_compatible
DEFAULT_LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# --- OpenAI-compatible ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY_ENV=OPENAI_API_KEY

# --- Strong model (for verification and final reasoning) ---
STRONG_LLM_PROVIDER=openai
STRONG_OPENAI_MODEL=gpt-4o
STRONG_OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# --- Fast/Cheap model (for classification) ---
FAST_LLM_PROVIDER=ollama
FAST_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
FAST_OPENAI_MODEL=gpt-3.5-turbo

# =============================================================================
# Reranker
# =============================================================================
RERANKER_PROVIDER=tei
RERANKER_BASE_URL=http://tei-reranker:8080
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TOP_K=10

# =============================================================================
# Embeddings
# =============================================================================
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-large
SENTENCE_TRANSFORMERS_DEVICE=cpu

# =============================================================================
# OCR
# =============================================================================
OCR_PROVIDER=tesseract
TESSERACT_CMD= tesseract
OCR_LANGUAGE=eng+deu+fra+spa
POPPLER_PATH=

# =============================================================================
# Telemetry
# =============================================================================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-ai
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=legal-ai-service
LOG_LEVEL=INFO
LOG_FORMAT=json
TRACING_ENABLED=false

# =============================================================================
# Prompt / Legal Configuration
# =============================================================================
LEGAL_JURISDICTION=us
LEGAL_LANGUAGE=en
LEGAL_DISCLAIMER_PATH=

# =============================================================================
# Tenants (comma-separated list of tenant keys this instance knows)
# =============================================================================
TENANTS=demo,acme,beta

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_WEB_SEARCH=false
FEATURE_OCR=true
FEATURE_SEMANIC_CACHE=true
FEATURE_HUMAN_IN_THE_LOOP=true
FEATURE_AUDIT_LOGGING=true
